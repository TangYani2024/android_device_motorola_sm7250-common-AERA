# Android fstab file.
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK

# mount point    fstype     device                                   device2                flags
# Logical partitions
/system_ext      ext4       system_ext                                                      flags=display="System_EXT"
/vendor_dlkm     ext4       vendor_dlkm                                                     flags=display="Vendor_DLKM"

# Userdata/Metadata partitions
/metadata        ext4       /dev/block/by-name/metadata                                     flags=backup=1;display="Metadata"

# Physical A/B & boot partitions
/boot            emmc       /dev/block/bootdevice/by-name/boot                              flags=backup=1;display="Boot";slotselect;flashimg=1
/recovery        emmc       /dev/block/bootdevice/by-name/recovery                          flags=backup=1;display="Recovery";slotselect;flashimg=1
/dtbo            emmc       /dev/block/bootdevice/by-name/dtbo                              flags=backup=1;display="DTBO";slotselect;flashimg=1
/vbmeta          emmc       /dev/block/bootdevice/by-name/vbmeta                            flags=backup=1;display="VBMeta";slotselect;flashimg=1
/vbmeta_system   emmc       /dev/block/bootdevice/by-name/vbmeta_system                     flags=backup=1;display="VBMeta System";slotselect;flashimg=1
/logo            emmc       /dev/block/bootdevice/by-name/logo                              flags=backup=1;display="Boot Logo";slotselect;flashimg=1
/super           emmc       /dev/block/bootdevice/by-name/super                             flags=backup=1;display="Super";flashimg=1
/misc            emmc       /dev/block/bootdevice/by-name/misc
/keymaster       emmc       /dev/block/bootdevice/by-name/keymaster                         flags=slotselect

# EFS partitions
/efs1            emmc       /dev/block/bootdevice/by-name/modemst1                          flags=backup=1;display="EFS"
/efs2            emmc       /dev/block/bootdevice/by-name/modemst2                          flags=backup=1;subpartitionof=/efs1

# Persist & Firmware partitions
/persist         ext4       /dev/block/bootdevice/by-name/persist                           flags=backup=1;display="Persist"
/persist_image   emmc       /dev/block/bootdevice/by-name/persist                           flags=backup=1;display="Persist Image";flashimg=1
/prodpersist     ext4       /dev/block/bootdevice/by-name/prodpersist                       flags=backup=1;display="Product Persist"
/firmware        ext4       /dev/block/bootdevice/by-name/modem                             flags=display="Firmware";mounttodecrypt;fsflags="ro,context=u:object_r:firmware_file:s0";slotselect
/modem           emmc       /dev/block/bootdevice/by-name/modem                             flags=backup=1;display="Modem";slotselect
/fsg             emmc       /dev/block/bootdevice/by-name/fsg                               flags=backup=1;display="Fsg";slotselect
/bluetooth       emmc       /dev/block/bootdevice/by-name/bluetooth                         flags=backup=1;display="Bluetooth";slotselect
/dsp             ext4       /dev/block/bootdevice/by-name/dsp                               flags=backup=1;display="Dsp";slotselect

# Removable storage
/external_sd     auto       /dev/block/mmcblk0p1                     /dev/block/mmcblk0     flags=display="Micro SDcard";storage;wipeingui;removable
/usb_otg         auto       /dev/block/sdg1                          /dev/block/sdg         flags=fsflags=utf8;display="USB OTG";storage;wipeingui;removable
